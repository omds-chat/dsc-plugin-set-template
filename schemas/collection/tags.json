{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omdsc-dev.github.io/awesome-dsc-plugin-set-template/schemas/collection/tags.json",
  "title": "dsc-plugin-collection-tags",
  "description": "插件合集根目录 tags.json,预设标签列表,可选文件。datalog.json 中的 tag 必须取自本文件;文件存在时允许空数组。",
  "type": "array",
  "items": {
    "type": "string",
    "minLength": 1,
    "maxLength": 32,
    "description": "标签文本"
  },
  "uniqueItems": true,
  "required": [],
  "additionalProperties": false
}
