{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omdsc-dev.github.io/awesome-dsc-plugin-set-template/schemas/collection/meta.json",
  "title": "dsc-plugin-collection-meta",
  "description": "插件合集根目录 meta.json。声明下载计数服务的开关、接口地址与 IP 上报策略,插件市场据此判断是否需要提示用户。",
  "type": "object",
  "properties": {
    "DOWNLOAD_COUNT_ENABLE": {
      "type": "boolean",
      "description": "是否启用下载计数。为 false 时其余两个字段不参与分发语义。"
    },
    "DOWNLOAD_COUNT_API": {
      "type": "string",
      "format": "uri",
      "minLength": 1,
      "description": "下载计数接口地址。启用计数时必填;市场每次下载插件会向其发送一次 POST 请求且不等待回复。"
    },
    "API_NEED_IP": {
      "type": "boolean",
      "description": "计数请求是否携带请求来源的公网 IP 地址。启用计数时必填,未启用时忽略。"
    }
  },
  "required": [
    "DOWNLOAD_COUNT_ENABLE"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "DOWNLOAD_COUNT_ENABLE": {
            "const": true
          }
        },
        "required": [
          "DOWNLOAD_COUNT_ENABLE"
        ]
      },
      "then": {
        "required": [
          "DOWNLOAD_COUNT_API",
          "API_NEED_IP"
        ]
      }
    }
  ]
}
