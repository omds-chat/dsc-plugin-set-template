{
  "name": "awesome-dsc-plugin-set-template",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "dsc 插件合集模板:分发规范 v2 的目录骨架、JSON Schema、OpenSSL PKI 签名与校验工具",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omds-chat/awesome-dsc-plugin-set-template.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "verify": "node scripts/verify-collection.mjs --dir template --allow-placeholder-eec",
    "build": "node scripts/build-collection.mjs --dir template --allow-placeholder-eec --out dist",
    "import": "node scripts/import-plugins.mjs"
  },
  "keywords": [
    "dsc",
    "dsc-plugin",
    "plugin-collection",
    "template",
    "openssl",
    "pki"
  ]
}
