{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omdsc-dev.github.io/awesome-dsc-plugin-set-template/schemas/collection/author_manifest.json",
  "title": "dsc-plugin-collection-author-manifest",
  "description": "插件合集 plugins/author_manifest.json,登记的作者清单。username 在清单内必须唯一,由校验脚本保证。",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "username": {
        "$ref": "#/$defs/authorName"
      },
      "profile": {
        "type": "string",
        "format": "uri",
        "minLength": 1,
        "description": "作者主页链接"
      }
    },
    "required": [
      "username",
      "profile"
    ],
    "additionalProperties": false
  },
  "uniqueItems": true,
  "required": [],
  "additionalProperties": false,
  "$defs": {
    "authorName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "maxLength": 39,
      "description": "作者英文名称,即作者目录名。仅允许小写字母、数字、连字符,不得以连字符开头或结尾。",
      "examples": [
        "alice",
        "omdsc-dev"
      ]
    }
  }
}
