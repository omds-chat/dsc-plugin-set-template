{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omdsc-dev.github.io/awesome-dsc-plugin-set-template/schemas/collection/versions.json",
  "title": "dsc-plugin-collection-versions",
  "description": "插件合集 plugins/author/plugin/versions.json,该插件的版本列表。latest 必须出现在 versions 中;versions 按版本号降序排列且不得重复,由校验脚本保证。",
  "type": "object",
  "properties": {
    "latest": {
      "$ref": "#/$defs/version",
      "description": "最新版本号,必须出现在 versions 列表内"
    },
    "versions": {
      "type": "array",
      "description": "全部版本号,按降序排列;每个版本号对应同目录下一个同名目录。",
      "items": {
        "$ref": "#/$defs/version"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "latest",
    "versions"
  ],
  "additionalProperties": false,
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "description": "语义化版本号,格式 x.y.z",
      "examples": [
        "1.0.0",
        "0.97.21"
      ]
    }
  }
}
